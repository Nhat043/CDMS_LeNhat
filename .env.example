# Emulated Vietful inventory service
INVENTORY_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/lenhat_inventory

# CDMS
CDMS_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@127.0.0.1:5432/lenhat_cdms

# Where the services listen
INVENTORY_BASE_URL=http://127.0.0.1:8001
CDMS_BASE_URL=http://127.0.0.1:8002

POLL_PAGE_SIZE=50
POLL_ENABLED=true
POLL_INTERVAL_SECONDS=30
WORKER_BATCH_SIZE=200
WORKER_IDLE_SLEEP_SECONDS=1.0

EXCEL_MAX_BYTES=5242880
EXCEL_MAX_ROWS=10000